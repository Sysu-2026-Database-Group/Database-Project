        <mxCell id="toy" value="&lt;b&gt;toy 文创&lt;/b&gt;&lt;br&gt;«子类型 / 细节»&lt;hr&gt;inner_code 【PK】&lt;br&gt;spec" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#EDEDED;strokeColor=#3D6EA5;" vertex="1" parent="1">
          <mxGeometry x="640" y="460" width="210" height="80" as="geometry" />
