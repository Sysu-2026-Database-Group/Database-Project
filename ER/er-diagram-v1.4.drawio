  <diagram id="er-v14-revised" name="v1.4 原布局修订">
    <mxGraphModel dx="2586" dy="967" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3060" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=16;fontStyle=1;fillColor=none;" value="拾光书店 · ER 图 v1.4&amp;nbsp;" vertex="1">
          <mxGeometry height="26" width="640" x="880" y="8" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#FAFAFA;strokeColor=#999999;" value="&lt;b&gt;图例&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK = 主键；UQ = 唯一约束，组合列一起唯一。&lt;br&gt;· 仅分隔属性，不表示复合键；括号圈出组合键。&lt;br&gt;普通连线表示联系，不表示流程方向。&lt;br&gt;(min,max)：min为0可选、为1必选；max为1至多一条、为N可多条。各数对表示该侧一条记录可关联对侧几条；每组数量前直接标明对象名称。&lt;br&gt;绿色空心三角 = 子类型，图书/文创互斥。&lt;br&gt;双线框 = 联系表 / 明细。&lt;br&gt;虚线椭圆 = 派生值，不存列。&lt;br&gt;跨线桥 = 交叉不相连。&lt;br&gt;数量为业务要求，不等同全部由数据库强制。&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="290" x="2740" y="40" as="geometry" />
        </mxCell>
        <mxCell id="nc2" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#FFF8D6;strokeColor=#B07A00;dashed=1;" value="C-2：18条业务留痕（C-4已计入）。&lt;br&gt;必填：留痕记录 (1,1) — 员工 (0,N)。&lt;br&gt;可空：留痕记录 (0,1) — 员工 (0,N)。&lt;br&gt;员工自引用另见 C-1。" vertex="1">
          <mxGeometry height="70" width="330" x="390" y="74" as="geometry" />
        </mxCell>
        <mxCell id="nc8" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#FFF8D6;strokeColor=#B07A00;dashed=1;" value="C-8 商品 ↔ 三类明细（汇总）&lt;br&gt;商品 (0,N) — 采购明细 (1,1)&lt;br&gt;商品 (0,N) — 销售明细 (1,1)&lt;br&gt;商品 (0,N) — 预订明细 (1,1)&lt;br&gt;三类明细的 goods_id 引用商品，不另铺长线。" vertex="1">
          <mxGeometry height="90" width="340" x="630" y="323" as="geometry" />
        </mxCell>
