        <mxCell id="purchase_request" value="&lt;b&gt;purchase_request 采购申请单&lt;/b&gt;&lt;br&gt;«实体 · 单据头»&lt;hr&gt;id 【PK】· no 【UQ】&lt;br&gt;supplier_id → supplier&lt;br&gt;status&lt;br&gt;submitted_by · approved_by" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#DDE7F5;strokeColor=#3D6EA5;" vertex="1" parent="1">
