        <mxCell id="title" value="拾光书店 · ER 图 v1.0（正式版 · 完整 19 张 · draw.io 手工布局 · 2026-10-11）" style="text;html=1;align=center;fontSize=16;fontStyle=1;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="880" y="8" width="640" height="26" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;图例（附录 A）&lt;/b&gt;&lt;br&gt;&lt;br&gt;矩形 = 实体&lt;br&gt;双线矩形 = 联系实体 / 弱实体&lt;br&gt;虚线椭圆 = 派生属性（不落库）&lt;br&gt;空心三角 = 子类型（与同类互斥）&lt;br&gt;连线两端 (min,max) = 参与约束（min 1 = 必须参与 / 0 = 可选参与；不是比值）&lt;br&gt;备注框 = 汇总边（一条线 + 注明包含哪些列）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#FAFAFA;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="2740" y="40" width="290" height="190" as="geometry" />
        </mxCell>
        <mxCell id="nc2" value="C-2 汇总边：17 类留痕列（含 card_type.set_by，另见 C-4）&#10;→ 图上画一条，注明包含哪些列；岗位 × 动作只有校验（I-02）" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#FFF8D6;strokeColor=#B07A00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="55" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nc8" value="C-8 汇总边：goods ↔ 三张明细的 goods_id（purchase_request_item · sale_item · reservation_item）；&#10;均为 (0,N)—(1,1)；C-8 不另画线，以本框注明" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#FFF8D6;strokeColor=#B07A00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="340" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="employee" value="&lt;b&gt;employee 员工&lt;/b&gt;&lt;hr&gt;phone 【PK】&lt;br&gt;name · role&lt;br&gt;created_by · updated_by → employee" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#DDE7F5;strokeColor=#3D6EA5;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="card_type" value="&lt;b&gt;card_type 会员卡档位&lt;/b&gt;&lt;hr&gt;level 【PK】银卡 / 金卡&lt;br&gt;card_fee · discount_rate&lt;br&gt;set_by → employee" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#DDE7F5;strokeColor=#3D6EA5;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="member" value="&lt;b&gt;member 会员&lt;/b&gt;&lt;hr&gt;phone 【PK】&lt;br&gt;card_level → card_type · expires_at&lt;br&gt;points_balance&lt;br&gt;opened_by · updated_by" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#DDE7F5;strokeColor=#3D6EA5;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="goods" value="&lt;b&gt;goods 商品&lt;/b&gt;&lt;br&gt;«超类 · 无业务候选标识»&lt;hr&gt;id 【PK】（代理键）&lt;br&gt;category · on_shelf · price&lt;br&gt;stock_total · reserved_qty&lt;br&gt;created_by · updated_by" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#DDE7F5;strokeColor=#3D6EA5;" vertex="1" parent="1">
