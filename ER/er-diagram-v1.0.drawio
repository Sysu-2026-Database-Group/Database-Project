        <mxCell id="purchase_request_item" value="&lt;b&gt;purchase_request_item 采购明细&lt;/b&gt;&lt;br&gt;«弱实体（明细）»&lt;hr&gt;id 【PK】&lt;br&gt;【UQ】(request_id, goods_id)&lt;br&gt;request_qty · unit_cost" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#F3E6D8;strokeColor=#8A4B08;" vertex="1" parent="1">
          <mxGeometry x="1450" y="250" width="250" height="110" as="geometry" />
        </mxCell>

        <mxCell id="sale" value="&lt;b&gt;sale 销售单&lt;/b&gt;&lt;br&gt;«实体 · 单据头»&lt;hr&gt;id 【PK】· no 【UQ】&lt;br&gt;member_phone → member（可空）&lt;br&gt;reservation_id → reservation（可空）&lt;br&gt;discount_rate · paid_amount · status&lt;br&gt;cashier_by" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#DDE7F5;strokeColor=#3D6EA5;" vertex="1" parent="1">
