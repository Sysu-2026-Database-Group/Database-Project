        </mxCell>
        <mxCell id="supplier" value="&lt;b&gt;supplier 供应商&lt;/b&gt;&lt;hr&gt;id 【PK】&lt;br&gt;name 【UQ】&lt;br&gt;created_by → employee" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#DDE7F5;strokeColor=#3D6EA5;" vertex="1" parent="1">
