        <mxCell id="derived" value="可售量&#10;（派生 · 不落库）" style="ellipse;whiteSpace=wrap;html=1;dashed=1;fontSize=10;fillColor=#FBFBFB;strokeColor=#888888;" vertex="1" parent="1">
