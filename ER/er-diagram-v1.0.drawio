        </mxCell>
        <mxCell id="book" value="&lt;b&gt;book 图书&lt;/b&gt;&lt;br&gt;«子类型 / 细节»&lt;hr&gt;isbn 【PK】&lt;br&gt;author · publisher · page_count" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;fillColor=#EDEDED;strokeColor=#3D6EA5;" vertex="1" parent="1">
          <mxGeometry x="370" y="460" width="210" height="90" as="geometry" />
